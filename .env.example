# Copy to .env and fill in. Never commit .env: real values live in the Vercel project settings.

# Contact form (app/api/send-contact-email). https://resend.com/api-keys
RESEND_API_KEY=

# Key of the links dashboard (its LINKS_API_KEY, shared by every site).
# Read only by scripts/sync-links.ts at build time. Required for the production build.
LINKS_DASHBOARD_TOKEN=
