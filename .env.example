# Copy to .env and fill in. Never commit .env: real values live in the Vercel project settings.

# Key of the links dashboard (its LINKS_API_KEY, shared by every site).
# Read only by scripts/sync-links.ts at build time. Required for the production build.
LINKS_DASHBOARD_TOKEN=

# --- Admin panel (/admin) ------------------------------------------------------
# Random secret that signs the session cookie: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the site (http://localhost:3000 in development).
BETTER_AUTH_URL=
# Google OAuth client. Authorized redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed into the panel.
ADMIN_EMAILS=
# Where the panel saves the products: a commit per change in this repository (owner/name).
# Fine-grained token with "Contents: read and write" on the repository. Without it (development only)
# the panel writes to the local data/ folder.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
