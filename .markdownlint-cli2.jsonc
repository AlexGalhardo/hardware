{
	// Rules: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
	"config": {
		"default": true,
		// Technical documentation with tables and long URLs: no line width limit.
		"MD013": false,
		// The changelog (Keep a Changelog) repeats "Added", "Fixed" etc. in every version.
		"MD024": { "siblings_only": true },
		// Centered README header (same as the workspace reference).
		"MD033": { "allowed_elements": ["div", "h1", "h3", "a", "strong"] },
		"MD041": false
	},
	"globs": ["*.md", ".claude/*.md", ".claude/rules/*.md", ".claude/skills/SOURCES.md", ".claude/skills/project-*/*.md", "docs/*.md", "docs/adrs/*.md"],
	"ignores": ["node_modules", "dist", "docs/prompts"]
}
