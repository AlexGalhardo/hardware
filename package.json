{
	"name": "tudohardware.com",
	"scripts": {
		"dev": "next dev",
		"build": "bun run csv && bun run sitemap && bun run stats && next build",
		"start": "bun run stats && bunx next build && next start",
		"lint": "next lint",
		"linter": "biome check app/ components/ --fix --unsafe",
		"format": "bun run csv && bun run stats && biome format tsconfig.json biome.json package.json app/ data/ emails/ components/ lib/ hooks/ --fix",
		"husky": "npx husky",
		"stats": "bun run scripts/data-jsons-stats.ts",
		"csv": "bun run scripts/create-csv.ts",
		"sitemap": "bun run scripts/create-sitemap.ts"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,json,jsonc}": [
			"biome check --apply --no-errors-on-unmatched"
		]
	},
