---
import { ArrowLeft } from "lucide-react";
import Footer from "@/components/Footer";
import { ContactFormAstro } from "@/components/contact-form-astro";
import Root from "../layouts/Root.astro";
---

<Root title="Contato - TudoHardware" description="Fale com o TudoHardware: relate um bug, tire uma dúvida ou envie uma sugestão.">
	<main class="min-h-screen bg-background">
		<div class="container px-4 py-8 mx-auto max-w-xl">
			<a
				href="/"
				class="inline-flex items-center text-sm text-black dark:text-white hover:text-foreground mb-8"
			>
				<ArrowLeft className="mr-2 h-4 w-4" />
				Voltar
			</a>

			<h1 class="text-3xl font-bold text-foreground mb-6 text-center">Contato</h1>

			<ContactFormAstro client:load />
		</div>
		<Footer client:idle />
	</main>
</Root>
